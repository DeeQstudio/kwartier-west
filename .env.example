# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking verification signing secret: use at least 32 random characters
BOOKING_VERIFY_SECRET=

# Vercel Blob private store
BLOB_READ_WRITE_TOKEN=

# Destination
BOOKING_TO_EMAIL=info@kwartierwest.be

# Option A: Resend
RESEND_API_KEY=
BOOKING_FROM_EMAIL=

# Option B: SMTP (used when RESEND_API_KEY is empty)
BOOKING_SMTP_HOST=
BOOKING_SMTP_PORT=587
BOOKING_SMTP_USER=
BOOKING_SMTP_PASS=
